    <string name="promo_dialog_title">Dùng Thử Miễn Phí Đợt Ra Mắt</string>
    <string name="promo_dialog_subtitle">Chào mừng bạn! Trong giai đoạn ra mắt và quảng bá, tất cả các tính năng đều hoàn toàn miễn phí 100% cho mọi người.</string>
    <string name="promo_feature_1">Không Giới Hạn Phòng &amp; Việc Nhà</string>
    <string name="promo_feature_1_desc">Lên kế hoạch dọn dẹp cho từng góc nhà mà không có bất kỳ giới hạn nào.</string>
    <string name="promo_feature_2">Lịch Lặp Lại Tùy Chỉnh</string>
    <string name="promo_feature_2_desc">Cài đặt chu kỳ lặp lại linh hoạt từ 1 đến 365 ngày.</string>
    <string name="promo_feature_3">Giờ Nhắc Nhở Riêng Biệt</string>
    <string name="promo_feature_3_desc">Tự do chọn khung giờ nhận thông báo nhắc nhở hàng ngày.</string>
    <string name="promo_future_notice_title">Thông Báo Về Các Phiên Bản Tương Lai</string>
    <string name="promo_future_notice_desc">Đây là phiên bản trải nghiệm sớm (early access). Trong các bản cập nhật tương lai, có thể sẽ bổ sung các tính năng nâng cao (Pro/Gói trả phí). Tuy nhiên, mọi dữ liệu, phòng và kế hoạch bạn tạo trong thời gian này sẽ vĩnh viễn được lưu trên máy của bạn và không bao giờ bị mất.</string>
    <string name="promo_btn_dismiss">Đã Hiểu, Cảm Ơn</string>
    <string name="promo_settings_card_title">Phiên Bản Ra Mắt (Mở Khóa Toàn Bộ)</string>
    <string name="promo_settings_card_desc">Không giới hạn phòng, chu kỳ tùy chỉnh và thông báo nhắc nhở hiện đang hoàn toàn miễn phí.</string>

