default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 1. Fetch or generate Distribution Certificate
    get_certificates(
      api_key: api_key
    )

    # 2. Fetch or generate App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.evduzeni.planner"
    )

    # 3. Explicitly configure Xcode project to use the App Store profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/EvDuzeni.xcodeproj",
      team_id: "XUVGCYL6L6",
      bundle_identifier: "com.evduzeni.planner",
      profile_name: ENV["SIGH_NAME"],
      code_sign_identity: "Apple Distribution"
    )

    # 4. Build application IPA
    build_app(
      project: "ios/EvDuzeni.xcodeproj",
      scheme: "EvDuzeni",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.evduzeni.planner" => ENV["SIGH_NAME"]
        }
      },
      output_directory: "build",
      output_name: "EvDuzeni.ipa"
    )

    # 5. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
